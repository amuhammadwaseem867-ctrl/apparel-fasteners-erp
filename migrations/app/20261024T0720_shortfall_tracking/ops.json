      {
        "description": "create table \"erp_shortfalls\"",
        "sql": "CREATE TABLE \"public\".\"erp_shortfalls\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdBy\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"notes\" text,\n  \"productId\" uuid,\n  \"quantity\" numeric NOT NULL,\n  \"reason\" text NOT NULL,\n  \"resolvedAt\" timestamptz,\n  \"resolvedBy\" uuid,\n  \"resolvedQuantity\" numeric DEFAULT '0'::numeric NOT NULL,\n  \"salesOrderId\" uuid NOT NULL,\n  \"salesOrderLineId\" uuid,\n  \"status\" text DEFAULT 'OPEN' NOT NULL,\n  \"unit\" text NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"erp_shortfalls_quantities_2d9cfd39\" CHECK (\"quantity\" > 0 AND \"resolvedQuantity\" >= 0 AND \"resolvedQuantity\" <= \"quantity\"),\n  CONSTRAINT \"erp_shortfalls_resolved_needs_date_c980bd89\" CHECK (\"status\" <> 'RESOLVED' OR \"resolvedAt\" IS NOT NULL),\n  CONSTRAINT \"erp_shortfalls_status_054ddf75\" CHECK (\"status\" IN ('OPEN', 'RESOLVED', 'CANCELLED'))\n)",
        "params": []
      }
    ],
