// use prisma-8
// ---------------------------------------------------------------------------
// Apparel Fasteners ERP — data contract (auth, sales, products, inventory)
//
// Conventions:
// - camelCase model/field names; snake_case physical table names via @@map.
// - Timestamps are TimestamptzString (text-backed) because the Node 24 runtime
//   lacks a global Temporal; never hand these to a Temporal codec.
// - No implicit many-to-many: Role-Permission and User-Role use explicit join
//   models (RolePermission, UserRole) as required by the SQL interpreter.
// ---------------------------------------------------------------------------

enum UserStatus {
  @@type("pg/text@1")
  ACTIVE = "ACTIVE"
  DISABLED = "DISABLED"
}

enum RoleStatus {
  @@type("pg/text@1")
  ACTIVE = "ACTIVE"
  DISABLED = "DISABLED"
}

model User {
  id           Uuid              @id @default(uuid())
  employeeCode String            @unique
  name         String
  email        String            @unique
  phone        String?
  passwordHash String
  status       UserStatus        @default(ACTIVE)
  lastLoginAt  TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())

  userRoles UserRole[]

  @@map("erp_users")
}

model Role {
  id          Uuid              @id @default(uuid())
  name        String            @unique
  code        String            @unique
  description String
  status      RoleStatus        @default(ACTIVE)
  isSystem    Boolean          @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("erp_roles")
}

model Permission {
  id          Uuid              @id @default(uuid())
  code        String            @unique
  name        String
  module      String
  action      String
  description String
  createdAt   TimestamptzString @default(now())

  rolePermissions RolePermission[]

  @@map("erp_permissions")
}

model RolePermission {
  id           Uuid              @id @default(uuid())
  roleId       Uuid
  permissionId Uuid
  grantedAt    TimestamptzString @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("erp_role_permissions")
}

model UserRole {
  id        Uuid              @id @default(uuid())
  userId    Uuid
  roleId    Uuid
  grantedAt TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("erp_user_roles")
}

model UserSession {
  id         Uuid               @id @default(uuid())
  userId     Uuid
  tokenHash  String             @unique
  expiresAt  TimestamptzString
  createdAt  TimestamptzString  @default(now())
  lastUsedAt TimestamptzString  @default(now())
  revokedAt  TimestamptzString?
  revokedBy  Uuid?
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("erp_user_sessions")
}

model AuditLog {
  id         Uuid              @id @default(uuid())
  actorId    Uuid?
  action     String
  entityType String?
  entityId   String?
  requestId  String?
  ip         String?
  metadata   String?
  createdAt  TimestamptzString @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("erp_audit_logs")
}

model Customer {
  id        Uuid              @id @default(uuid())
  code      String            @unique
  name      String
  email     String?
  phone     String?
  status    String            @default("ACTIVE")
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@index([name])
  @@map("erp_customers")
}

model Product {
  id          Uuid              @id @default(uuid())
  sku         String            @unique
  name        String
  description String?
  category    String
  productType String
  variant     String?
  unit        String
  unitPrice   Decimal           @default(0)
  status      String            @default("ACTIVE")
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  // Item master specification (Phase 3). Every distinct size / material /
  // type / finish / colour / logo combination is its own product and SKU.
  size         String?
  material     String?
  itemType     String?
  finish       String?
  color        String?
  logoType     String?
  barcode      String?           @unique
  minimumStock Decimal           @default(0)

  salesOrderLines   SalesOrderLine[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  boms              Bom[]
  bomComponentLines BomLine[]
  mrpRequirements   MrpRequirement[]
  mrpPlannedOrders  MrpPlannedOrder[]
  productionOrders  ProductionOrder[]
  qualityInspections QualityInspection[]
  packingLists      PackingList[]
  shipmentLines     ShipmentLine[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@check(expression: "\"minimumStock\" >= 0", name: "erp_products_minimum_stock_nonnegative")
  @@map("erp_products")
}

model SalesOrder {
  id             Uuid              @id @default(uuid())
  orderNumber    String            @unique
  customerId     Uuid
  orderDate      String
  deliveryDate   String?
  status         String            @default("DRAFT")
  notes          String?
  subtotal       Decimal           @default(0)
  discountTotal  Decimal           @default(0)
  taxTotal       Decimal           @default(0)
  totalAmount    Decimal           @default(0)
  createdBy      Uuid
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    SalesOrderLine[]
  shipments Shipment[]
  invoices  Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("erp_sales_orders")
}

model SalesOrderLine {
  id                Uuid    @id @default(uuid())
  salesOrderId      Uuid
  productId         Uuid?
  isCustom          Boolean @default(false)
  productName       String
  customerReference String?
  skuReference      String?
  category          String?
  variant           String?
  unit              String
  quantity          Decimal
  unitPrice         Decimal
  discountPercent   Int     @default(0)
  taxPercent        Int     @default(0)
  lineTotal         Decimal
  notes             String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
  @@index([productId])
  @@map("erp_sales_order_lines")
}

// ---------------------------------------------------------------------------
// Inventory (Phase 3)
//
// - StockBalance is the current position per product and storage location.
//   It changes only inside a stock-document transaction, by atomic
//   conditional UPDATEs, and CHECK constraints keep every bucket >= 0 and
//   reserved + quality hold <= on hand.
// - StockDocument + StockMovement are the append-only ledger. Every change
//   to a balance writes one movement row carrying the signed delta and the
//   resulting balance. Documents carry a unique idempotency key so a
//   repeated submission returns the original document instead of posting
//   twice.
// - Master data referenced by history is never cascade-deleted (Restrict);
//   it is archived through its status instead.
// ---------------------------------------------------------------------------

model Warehouse {
  id            Uuid              @id @default(uuid())
  code          String            @unique
  name          String
  warehouseType String            @default("GENERAL")
  address       String?
  status        String            @default("ACTIVE")
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())

  locations StorageLocation[]

  @@index([status])
  @@map("erp_warehouses")
}

model StorageLocation {
  id          Uuid              @id @default(uuid())
  warehouseId Uuid
  code        String
  name        String
  status      String            @default("ACTIVE")
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  balances     StockBalance[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([warehouseId, code])
  @@map("erp_storage_locations")
}

model StockBalance {
  id          Uuid              @id @default(uuid())
  productId   Uuid
  locationId  Uuid
  onHand      Decimal           @default(0)
  reserved    Decimal           @default(0)
  qualityHold Decimal           @default(0)
  updatedAt   TimestamptzString @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId])
  @@check(expression: "\"onHand\" >= 0 AND \"reserved\" >= 0 AND \"qualityHold\" >= 0", name: "erp_stock_balances_nonnegative")
  @@check(expression: "\"reserved\" + \"qualityHold\" <= \"onHand\"", name: "erp_stock_balances_committed_within_on_hand")
  @@map("erp_stock_balances")
}

model StockDocument {
  id             Uuid              @id @default(uuid())
  documentNumber String            @unique
  documentType   String
  status         String            @default("POSTED")
  reference      String?
  reason         String?
  notes          String?
  sourceType     String?
  sourceId       String?
  idempotencyKey String            @unique
  createdBy      Uuid
  postedAt       TimestamptzString @default(now())

  movements StockMovement[]

  @@index([documentType])
  @@index([postedAt])
  @@index([sourceType, sourceId])
  @@map("erp_stock_documents")
}

model StockMovement {
  id            Uuid              @id @default(uuid())
  documentId    Uuid
  lineNo        Int
  movementType  String
  productId     Uuid
  locationId    Uuid
  bucket        String
  quantityDelta Decimal
  balanceAfter  Decimal
  reservationId Uuid?
  createdBy     Uuid
  createdAt     TimestamptzString @default(now())

  document StockDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([documentId, lineNo, bucket])
  @@index([productId, createdAt])
  @@index([locationId])
  @@index([movementType])
  @@check(expression: "\"quantityDelta\" <> 0", name: "erp_stock_movements_nonzero")
  @@check(expression: "\"bucket\" IN ('ON_HAND', 'RESERVED', 'QUALITY_HOLD')", name: "erp_stock_movements_bucket")
  @@map("erp_stock_movements")
}

model StockReservation {
  id               Uuid              @id @default(uuid())
  productId        Uuid
  locationId       Uuid
  salesOrderId     Uuid?
  salesOrderLineId Uuid?
  quantity         Decimal
  consumedQuantity Decimal           @default(0)
  releasedQuantity Decimal           @default(0)
  status           String            @default("ACTIVE")
  notes            String?
  createdBy        Uuid
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([salesOrderId])
  @@index([status])
  @@check(expression: "\"quantity\" > 0 AND \"consumedQuantity\" >= 0 AND \"releasedQuantity\" >= 0 AND \"consumedQuantity\" + \"releasedQuantity\" <= \"quantity\"", name: "erp_stock_reservations_quantities")
  @@map("erp_stock_reservations")
}

model DocumentSequence {
  key       String            @id
  nextValue Int               @default(1)
  updatedAt TimestamptzString @default(now())

  @@check(expression: "\"nextValue\" >= 1", name: "erp_document_sequences_positive")
  @@map("erp_document_sequences")
}


// ---------------------------------------------------------------------------
// Bill of materials and MRP (Phase 4)
//
// - A BOM belongs to a parent item and has numbered revisions. Only DRAFT
//   revisions are edited; approved ones are copied into a new draft. At most
//   one revision per item is active (partial unique index).
// - BomLine quantity is per ONE unit of the parent, in the component's unit.
//   scrapPercent is applied once: gross = net x (1 + scrap / 100).
// - MRP runs are stored with their demand, per-item requirements and the
//   planned orders they suggested, so a historical plan stays explainable.
// ---------------------------------------------------------------------------

model Bom {
  id            Uuid              @id @default(uuid())
  productId     Uuid
  revision      Int
  status        String            @default("DRAFT")
  isActive      Boolean           @default(false)
  effectiveFrom String?
  notes         String?
  createdBy     Uuid
  approvedBy    Uuid?
  approvedAt    TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())

  product Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lines   BomLine[]

  @@unique([productId, revision])
  @@index([productId], where: "\"isActive\"", unique: true, name: "erp_boms_one_active_per_product")
  @@check(expression: "\"revision\" >= 1", name: "erp_boms_revision_positive")
  @@check(expression: "\"status\" IN ('DRAFT', 'APPROVED', 'OBSOLETE')", name: "erp_boms_status")
  @@check(expression: "NOT \"isActive\" OR \"status\" = 'APPROVED'", name: "erp_boms_active_is_approved")
  @@map("erp_boms")
}

model BomLine {
  id           Uuid    @id @default(uuid())
  bomId        Uuid
  lineNo       Int
  componentId  Uuid
  quantity     Decimal
  scrapPercent Decimal @default(0)
  notes        String?

  bom       Bom     @relation(fields: [bomId], references: [id], onDelete: Restrict)
  component Product @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([bomId, componentId])
  @@unique([bomId, lineNo])
  @@index([componentId])
  @@check(expression: "\"quantity\" > 0", name: "erp_bom_lines_quantity_positive")
  @@check(expression: "\"scrapPercent\" >= 0 AND \"scrapPercent\" < 100", name: "erp_bom_lines_scrap_range")
  @@map("erp_bom_lines")
}

model MrpRun {
  id           Uuid              @id @default(uuid())
  runNumber    String            @unique
  status       String            @default("COMPLETED")
  parameters   String
  demandCount  Int               @default(0)
  plannedCount Int               @default(0)
  createdBy    Uuid
  createdAt    TimestamptzString @default(now())

  demands       MrpDemand[]
  requirements  MrpRequirement[]
  plannedOrders MrpPlannedOrder[]

  @@index([createdAt])
  @@map("erp_mrp_runs")
}

model MrpDemand {
  id               Uuid    @id @default(uuid())
  runId            Uuid
  salesOrderId     Uuid
  salesOrderLineId Uuid
  orderNumber      String
  productId        Uuid
  quantity         Decimal
  dueDate          String?

  run MrpRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@map("erp_mrp_demands")
}

model MrpRequirement {
  id                Uuid    @id @default(uuid())
  runId             Uuid
  productId         Uuid
  lowLevelCode      Int
  grossRequirement  Decimal
  allocatedStock    Decimal
  availableStock    Decimal
  netRequirement    Decimal
  plannedQuantity   Decimal
  supplyType        String
  bomId             Uuid?
  bomRevision       Int?

  run     MrpRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([runId, productId])
  @@check(expression: "\"supplyType\" IN ('MAKE', 'BUY')", name: "erp_mrp_requirements_supply_type")
  @@map("erp_mrp_requirements")
}

model MrpPlannedOrder {
  id          Uuid               @id @default(uuid())
  runId       Uuid
  productId   Uuid
  orderType   String
  quantity    Decimal
  dueDate     String?
  status      String             @default("SUGGESTED")
  confirmedBy Uuid?
  confirmedAt TimestamptzString?

  run     MrpRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([status])
  @@check(expression: "\"quantity\" > 0", name: "erp_mrp_planned_orders_quantity_positive")
  @@check(expression: "\"orderType\" IN ('MAKE', 'BUY')", name: "erp_mrp_planned_orders_type")
  @@check(expression: "\"status\" IN ('SUGGESTED', 'CONFIRMED', 'CANCELLED')", name: "erp_mrp_planned_orders_status")
  @@map("erp_mrp_planned_orders")
}


// ---------------------------------------------------------------------------
// Production (Phase 5): production orders and the nine-stage workflow.
//
// Quantity rule per stage (all in the production order's unit):
//   received  = order quantity (stage 1) or accepted output of the
//               previous stage
//   processed = accepted + rejected + wastage + rework   (CHECK)
//   available = received + rework - processed            (never < 0)
// Rework units return to the same stage's queue. A stage completes only
// when the previous stage is complete and nothing is left in its queue.
// Stage runs and events are append-only history.
// ---------------------------------------------------------------------------

model ProductionOrder {
  id               Uuid               @id @default(uuid())
  orderNumber      String             @unique
  productId        Uuid
  quantity         Decimal
  unit             String
  salesOrderId     Uuid?
  salesOrderLineId Uuid?
  plannedOrderId   Uuid?              @unique
  bomId            Uuid?
  bomRevision      Int?
  priority         String             @default("NORMAL")
  status           String             @default("PLANNED")
  holdFromStatus   String?
  currentStage     String?
  dueDate          String?
  notes            String?
  createdBy        Uuid
  createdAt        TimestamptzString  @default(now())
  updatedAt        TimestamptzString  @default(now())
  completedAt      TimestamptzString?

  product Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  stages             ProductionStage[]
  events             ProductionEvent[]
  qualityInspections QualityInspection[]
  packingLists       PackingList[]

  @@index([status])
  @@index([salesOrderId])
  @@index([dueDate])
  @@check(expression: "\"quantity\" > 0", name: "erp_production_orders_quantity_positive")
  @@check(expression: "\"status\" IN ('PLANNED', 'RELEASED', 'IN_PROGRESS', 'ON_HOLD', 'COMPLETED', 'CANCELLED')", name: "erp_production_orders_status")
  @@check(expression: "\"priority\" IN ('LOW', 'NORMAL', 'HIGH', 'URGENT')", name: "erp_production_orders_priority")
  @@map("erp_production_orders")
}

model ProductionStage {
  id                Uuid               @id @default(uuid())
  productionOrderId Uuid
  stageKey          String
  sequence          Int
  status            String             @default("PENDING")
  processedQuantity Decimal            @default(0)
  acceptedQuantity  Decimal            @default(0)
  rejectedQuantity  Decimal            @default(0)
  wastageQuantity   Decimal            @default(0)
  reworkQuantity    Decimal            @default(0)
  department        String?
  responsibleName   String?
  startedAt         TimestamptzString?
  completedAt       TimestamptzString?
  updatedAt         TimestamptzString  @default(now())

  productionOrder ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  runs            ProductionStageRun[]

  @@unique([productionOrderId, stageKey])
  @@unique([productionOrderId, sequence])
  @@check(expression: "\"sequence\" BETWEEN 1 AND 9", name: "erp_production_stages_sequence")
  @@check(expression: "\"status\" IN ('PENDING', 'IN_PROGRESS', 'COMPLETED')", name: "erp_production_stages_status")
  @@check(expression: "\"acceptedQuantity\" >= 0 AND \"rejectedQuantity\" >= 0 AND \"wastageQuantity\" >= 0 AND \"reworkQuantity\" >= 0", name: "erp_production_stages_nonnegative")
  @@check(expression: "\"processedQuantity\" = \"acceptedQuantity\" + \"rejectedQuantity\" + \"wastageQuantity\" + \"reworkQuantity\"", name: "erp_production_stages_balance")
  @@map("erp_production_stages")
}

model ProductionStageRun {
  id               Uuid              @id @default(uuid())
  stageId          Uuid
  runNo            Int
  inputQuantity    Decimal
  acceptedQuantity Decimal
  rejectedQuantity Decimal           @default(0)
  wastageQuantity  Decimal           @default(0)
  reworkQuantity   Decimal           @default(0)
  operatorName     String?
  workstation      String?
  remarks          String?
  idempotencyKey   String            @unique
  recordedBy       Uuid
  recordedAt       TimestamptzString @default(now())

  stage ProductionStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@unique([stageId, runNo])
  @@check(expression: "\"inputQuantity\" > 0 AND \"acceptedQuantity\" >= 0 AND \"rejectedQuantity\" >= 0 AND \"wastageQuantity\" >= 0 AND \"reworkQuantity\" >= 0", name: "erp_production_stage_runs_quantities")
  @@check(expression: "\"inputQuantity\" = \"acceptedQuantity\" + \"rejectedQuantity\" + \"wastageQuantity\" + \"reworkQuantity\"", name: "erp_production_stage_runs_balance")
  @@map("erp_production_stage_runs")
}

model ProductionEvent {
  id                Uuid              @id @default(uuid())
  productionOrderId Uuid
  stageKey          String?
  eventType         String
  fromValue         String?
  toValue           String?
  details           String?
  actorId           Uuid
  createdAt         TimestamptzString @default(now())

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  @@index([productionOrderId, createdAt])
  @@map("erp_production_events")
}

// Phase 6: quality, packing and dispatch (see docs/ERP_DECISIONS.md D-022).

/// A quality inspection. INCOMING inspects stock held under QC at a
/// location; IN_PROCESS and FINAL inspect a production order's stage
/// output. Results are fixed when the inspection is recorded; approval
/// applies them (stock release/rejection, or the stage run) exactly once.
model QualityInspection {
  id                Uuid               @id @default(uuid())
  inspectionNumber  String             @unique
  inspectionType    String
  status            String             @default("OPEN")
  productId         Uuid
  productionOrderId Uuid?
  stageKey          String?
  locationId        Uuid?
  inspectedQuantity Decimal
  passedQuantity    Decimal
  reworkQuantity    Decimal            @default(0)
  rejectedQuantity  Decimal            @default(0)
  sampleSize        Int?
  defects           String?
  inspectorName     String?
  remarks           String?
  idempotencyKey    String             @unique
  createdBy         Uuid
  createdAt         TimestamptzString  @default(now())
  decidedBy         Uuid?
  decidedAt         TimestamptzString?
  decisionNote      String?

  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  @@index([inspectionType, status])
  @@index([productionOrderId])
  @@check(expression: "\"inspectionType\" IN ('INCOMING', 'IN_PROCESS', 'FINAL')", name: "erp_quality_inspections_type")
  @@check(expression: "\"status\" IN ('OPEN', 'APPROVED', 'CANCELLED')", name: "erp_quality_inspections_status")
  @@check(expression: "\"inspectedQuantity\" > 0 AND \"passedQuantity\" >= 0 AND \"reworkQuantity\" >= 0 AND \"rejectedQuantity\" >= 0", name: "erp_quality_inspections_quantities")
  @@check(expression: "\"inspectedQuantity\" = \"passedQuantity\" + \"reworkQuantity\" + \"rejectedQuantity\"", name: "erp_quality_inspections_balance")
  @@map("erp_quality_inspections")
}

/// Packed output of a production order. Confirming records the packing
/// stage run and receives the packed quantity into finished-goods stock.
model PackingList {
  id                Uuid               @id @default(uuid())
  packingNumber     String             @unique
  productionOrderId Uuid
  productId         Uuid
  salesOrderId      Uuid?
  locationId        Uuid
  status            String             @default("DRAFT")
  totalQuantity     Decimal
  packageCount      Int
  shipmentId        Uuid?
  notes             String?
  idempotencyKey    String             @unique
  createdBy         Uuid
  createdAt         TimestamptzString  @default(now())
  confirmedBy       Uuid?
  confirmedAt       TimestamptzString?

  productionOrder ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  packages        PackingPackage[]

  @@index([productionOrderId])
  @@index([salesOrderId, status])
  @@check(expression: "\"status\" IN ('DRAFT', 'CONFIRMED', 'SHIPPED', 'CANCELLED')", name: "erp_packing_lists_status")
  @@check(expression: "\"totalQuantity\" > 0 AND \"packageCount\" > 0", name: "erp_packing_lists_totals")
  @@map("erp_packing_lists")
}

model PackingPackage {
  id            Uuid     @id @default(uuid())
  packingListId Uuid
  packageNo     Int
  packageType   String
  quantity      Decimal
  netWeight     Decimal?
  grossWeight   Decimal?
  dimensions    String?
  marks         String?

  packingList PackingList @relation(fields: [packingListId], references: [id], onDelete: Restrict)

  @@unique([packingListId, packageNo])
  @@check(expression: "\"quantity\" > 0", name: "erp_packing_packages_quantity_positive")
  @@check(expression: "(\"netWeight\" IS NULL OR \"netWeight\" >= 0) AND (\"grossWeight\" IS NULL OR \"grossWeight\" >= 0)", name: "erp_packing_packages_weights")
  @@map("erp_packing_packages")
}

/// A delivery to a customer against one sales order. Dispatching posts a
/// finished-goods dispatch from the ship-from location; delivery records
/// the Delivered stage of each packed production order.
model Shipment {
  id                Uuid               @id @default(uuid())
  shipmentNumber    String             @unique
  salesOrderId      Uuid
  customerId        Uuid
  locationId        Uuid
  status            String             @default("DRAFT")
  vehicleNumber     String?
  driverName        String?
  driverPhone       String?
  transporter       String?
  trackingReference String?
  deliveryAddress   String?
  notes             String?
  idempotencyKey    String             @unique
  createdBy         Uuid
  createdAt         TimestamptzString  @default(now())
  dispatchedBy      Uuid?
  dispatchedAt      TimestamptzString?
  deliveredBy       Uuid?
  deliveredAt       TimestamptzString?
  receivedBy        String?
  deliveryNote      String?

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lines      ShipmentLine[]

  @@index([salesOrderId])
  @@index([status])
  @@check(expression: "\"status\" IN ('DRAFT', 'DISPATCHED', 'DELIVERED', 'CANCELLED')", name: "erp_shipments_status")
  @@map("erp_shipments")
}

model ShipmentLine {
  id               Uuid    @id @default(uuid())
  shipmentId       Uuid
  lineNo           Int
  productId        Uuid
  salesOrderLineId Uuid?
  packingListId    Uuid?
  quantity         Decimal

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, lineNo])
  @@index([packingListId])
  @@check(expression: "\"quantity\" > 0", name: "erp_shipment_lines_quantity_positive")
  @@map("erp_shipment_lines")
}

// Phase 7: invoicing and receivables (see docs/ERP_DECISIONS.md D-023).
// Amounts are exact decimals in whole cents; nothing is deleted: invoices
// are corrected by credit notes, receipts by voiding.

/// A customer invoice for one dispatched shipment. Prices, discounts and tax
/// come from the approved sales order lines; nothing is invented.
model Invoice {
  id             Uuid               @id @default(uuid())
  invoiceNumber  String             @unique
  customerId     Uuid
  salesOrderId   Uuid
  shipmentId     Uuid
  invoiceDate    String
  dueDate        String
  status         String             @default("DRAFT")
  subtotal       Decimal
  discountTotal  Decimal
  taxTotal       Decimal
  totalAmount    Decimal
  notes          String?
  idempotencyKey String             @unique
  createdBy      Uuid
  createdAt      TimestamptzString  @default(now())
  issuedBy       Uuid?
  issuedAt       TimestamptzString?
  cancelledBy    Uuid?
  cancelledAt    TimestamptzString?
  cancelReason   String?

  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder  SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  creditNotes CreditNote[]
  receipts    CustomerReceipt[]

  @@index([customerId, status])
  @@index([salesOrderId])
  @@index([dueDate])
  @@index([shipmentId], where: "\"status\" <> 'CANCELLED'", unique: true, name: "erp_invoices_one_per_shipment")
  @@check(expression: "\"status\" IN ('DRAFT', 'ISSUED', 'CANCELLED')", name: "erp_invoices_status")
  @@check(expression: "\"subtotal\" >= 0 AND \"discountTotal\" >= 0 AND \"taxTotal\" >= 0", name: "erp_invoices_nonnegative")
  @@check(expression: "\"totalAmount\" = \"subtotal\" - \"discountTotal\" + \"taxTotal\"", name: "erp_invoices_total")
  @@map("erp_invoices")
}

model InvoiceLine {
  id               Uuid    @id @default(uuid())
  invoiceId        Uuid
  lineNo           Int
  productId        Uuid?
  salesOrderLineId Uuid?
  description      String
  unit             String
  quantity         Decimal
  unitPrice        Decimal
  discountPercent  Int
  taxPercent       Int
  grossAmount      Decimal
  discountAmount   Decimal
  taxAmount        Decimal
  lineTotal        Decimal

  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creditLines CreditNoteLine[]

  @@unique([invoiceId, lineNo])
  @@check(expression: "\"quantity\" > 0 AND \"unitPrice\" >= 0", name: "erp_invoice_lines_quantity")
  @@check(expression: "\"discountPercent\" BETWEEN 0 AND 100 AND \"taxPercent\" BETWEEN 0 AND 100", name: "erp_invoice_lines_percents")
  @@check(expression: "\"lineTotal\" = \"grossAmount\" - \"discountAmount\" + \"taxAmount\"", name: "erp_invoice_lines_total")
  @@map("erp_invoice_lines")
}

/// Credits part or all of an issued invoice (returns, price corrections).
/// Credit notes are final; they reduce what the customer owes.
model CreditNote {
  id             Uuid              @id @default(uuid())
  creditNumber   String            @unique
  invoiceId      Uuid
  customerId     Uuid
  creditDate     String
  reason         String
  subtotal       Decimal
  discountTotal  Decimal
  taxTotal       Decimal
  totalAmount    Decimal
  idempotencyKey String            @unique
  createdBy      Uuid
  createdAt      TimestamptzString @default(now())

  invoice Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lines   CreditNoteLine[]

  @@index([invoiceId])
  @@index([customerId])
  @@check(expression: "\"totalAmount\" > 0 AND \"totalAmount\" = \"subtotal\" - \"discountTotal\" + \"taxTotal\"", name: "erp_credit_notes_total")
  @@map("erp_credit_notes")
}

model CreditNoteLine {
  id             Uuid    @id @default(uuid())
  creditNoteId   Uuid
  invoiceLineId  Uuid
  quantity       Decimal
  grossAmount    Decimal
  discountAmount Decimal
  taxAmount      Decimal
  lineTotal      Decimal

  creditNote  CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)

  @@unique([creditNoteId, invoiceLineId])
  @@check(expression: "\"quantity\" > 0", name: "erp_credit_note_lines_quantity")
  @@check(expression: "\"lineTotal\" = \"grossAmount\" - \"discountAmount\" + \"taxAmount\"", name: "erp_credit_note_lines_total")
  @@map("erp_credit_note_lines")
}

/// Money received from a customer against one issued invoice. A wrong
/// receipt is voided (with a reason), never deleted.
model CustomerReceipt {
  id             Uuid               @id @default(uuid())
  receiptNumber  String             @unique
  invoiceId      Uuid
  customerId     Uuid
  receiptDate    String
  method         String
  reference      String?
  amount         Decimal
  status         String             @default("POSTED")
  notes          String?
  idempotencyKey String             @unique
  createdBy      Uuid
  createdAt      TimestamptzString  @default(now())
  voidedBy       Uuid?
  voidedAt       TimestamptzString?
  voidReason     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@index([customerId])
  @@index([receiptDate])
  @@check(expression: "\"amount\" > 0", name: "erp_customer_receipts_amount_positive")
  @@check(expression: "\"status\" IN ('POSTED', 'VOIDED')", name: "erp_customer_receipts_status")
  @@check(expression: "\"method\" IN ('CASH', 'BANK_TRANSFER', 'CHEQUE', 'CARD', 'OTHER')", name: "erp_customer_receipts_method")
  @@map("erp_customer_receipts")
}

/// Failed-login counters shared by every server instance (D-025). `key` is
/// a SHA-256 hash of "email:<address>" or "ip:<address>", so raw emails and
/// IP addresses are not stored. Rows older than the window are discarded.
model LoginAttemptCounter {
  key         String            @id
  count       Int
  windowStart TimestamptzString
  updatedAt   TimestamptzString @default(now())

  @@index([windowStart])
  @@check(expression: "\"count\" > 0", name: "erp_login_attempt_counters_count_positive")
  @@map("erp_login_attempt_counters")
}

/// A gate pass authorises goods to leave (or enter) through the factory
/// gate (D-026). It records the movement and, for returnable passes, what
/// came back; it does not post stock (inventory and dispatch do that).
model GatePass {
  id                 Uuid               @id @default(uuid())
  passNumber         String             @unique
  passType           String
  status             String             @default("DRAFT")
  partyName          String
  purpose            String
  shipmentId         Uuid?
  vehicleNumber      String?
  driverName         String?
  expectedReturnDate String?
  notes              String?
  idempotencyKey     String             @unique
  createdBy          Uuid
  createdAt          TimestamptzString  @default(now())
  approvedBy         Uuid?
  approvedAt         TimestamptzString?
  passedBy           Uuid?
  passedAt           TimestamptzString?
  guardName          String?
  closedAt           TimestamptzString?
  cancelledBy        Uuid?
  cancelledAt        TimestamptzString?
  cancelReason       String?

  lines GatePassLine[]

  @@index([status])
  @@index([shipmentId])
  @@check(expression: "\"passType\" IN ('INWARD', 'OUTWARD_NON_RETURNABLE', 'OUTWARD_RETURNABLE')", name: "erp_gate_passes_type")
  @@check(expression: "\"status\" IN ('DRAFT', 'APPROVED', 'OUT', 'COMPLETED', 'CANCELLED')", name: "erp_gate_passes_status")
  @@check(expression: "\"passType\" <> 'OUTWARD_RETURNABLE' OR \"expectedReturnDate\" IS NOT NULL", name: "erp_gate_passes_return_date")
  @@map("erp_gate_passes")
}

model GatePassLine {
  id               Uuid    @id @default(uuid())
  gatePassId       Uuid
  lineNo           Int
  productId        Uuid?
  description      String
  unit             String
  quantity         Decimal
  returnedQuantity Decimal @default(0)

  gatePass GatePass @relation(fields: [gatePassId], references: [id], onDelete: Restrict)

  @@unique([gatePassId, lineNo])
  @@check(expression: "\"quantity\" > 0 AND \"returnedQuantity\" >= 0 AND \"returnedQuantity\" <= \"quantity\"", name: "erp_gate_pass_lines_quantities")
  @@map("erp_gate_pass_lines")
}

// Phase 8: HR and payroll (see docs/ERP_DECISIONS.md D-027). Pay fields are
// returned only to users with payroll:view; amounts are exact decimals.

model Department {
  id        Uuid              @id @default(uuid())
  code      String            @unique
  name      String            @unique
  status    String            @default("ACTIVE")
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  employees Employee[]

  @@check(expression: "\"status\" IN ('ACTIVE', 'INACTIVE')", name: "erp_departments_status")
  @@map("erp_departments")
}

model Employee {
  id             Uuid              @id @default(uuid())
  employeeCode   String            @unique
  name           String
  fatherName     String?
  nationalId     String?
  phone          String?
  address        String?
  departmentId   Uuid
  designation    String
  employmentType String
  joinDate       String
  leftDate       String?
  status         String            @default("ACTIVE")
  payBasis       String            @default("MONTHLY")
  basicSalary    Decimal           @default(0)
  allowances     Decimal           @default(0)
  overtimeRate   Decimal           @default(0)
  fixedDeduction Decimal           @default(0)
  bankAccount    String?
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())

  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  attendance   AttendanceRecord[]
  advances     SalaryAdvance[]
  payrollLines PayrollLine[]

  @@index([departmentId])
  @@index([status])
  @@check(expression: "\"employmentType\" IN ('PERMANENT', 'CONTRACT', 'DAILY_WAGE')", name: "erp_employees_type")
  @@check(expression: "\"status\" IN ('ACTIVE', 'LEFT')", name: "erp_employees_status")
  @@check(expression: "\"payBasis\" IN ('MONTHLY', 'DAILY')", name: "erp_employees_pay_basis")
  @@check(expression: "\"basicSalary\" >= 0 AND \"allowances\" >= 0 AND \"overtimeRate\" >= 0 AND \"fixedDeduction\" >= 0", name: "erp_employees_pay_nonnegative")
  @@check(expression: "\"leftDate\" IS NULL OR \"leftDate\" >= \"joinDate\"", name: "erp_employees_dates")
  @@map("erp_employees")
}

model AttendanceRecord {
  id            Uuid              @id @default(uuid())
  employeeId    Uuid
  date          String
  status        String
  overtimeHours Decimal           @default(0)
  remarks       String?
  recordedBy    Uuid
  recordedAt    TimestamptzString @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([date])
  @@check(expression: "\"status\" IN ('PRESENT', 'ABSENT', 'HALF_DAY', 'PAID_LEAVE', 'UNPAID_LEAVE', 'HOLIDAY', 'WEEKLY_OFF')", name: "erp_attendance_status")
  @@check(expression: "\"overtimeHours\" >= 0 AND \"overtimeHours\" <= 24", name: "erp_attendance_overtime")
  @@map("erp_attendance_records")
}

model SalaryAdvance {
  id            Uuid               @id @default(uuid())
  advanceNumber String             @unique
  employeeId    Uuid
  issueDate     String
  amount        Decimal
  installment   Decimal
  recovered     Decimal            @default(0)
  status        String             @default("OPEN")
  reason        String
  idempotencyKey String?           @unique
  createdBy     Uuid
  createdAt     TimestamptzString  @default(now())
  cancelledBy   Uuid?
  cancelledAt   TimestamptzString?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@check(expression: "\"amount\" > 0 AND \"installment\" > 0 AND \"installment\" <= \"amount\" AND \"recovered\" >= 0 AND \"recovered\" <= \"amount\"", name: "erp_salary_advances_amounts")
  @@check(expression: "\"status\" IN ('OPEN', 'CLOSED', 'CANCELLED')", name: "erp_salary_advances_status")
  @@map("erp_salary_advances")
}

model PayrollRun {
  id              Uuid               @id @default(uuid())
  runNumber       String             @unique
  period          String
  status          String             @default("DRAFT")
  periodDays      Int
  employeeCount   Int
  grossTotal      Decimal
  deductionTotal  Decimal
  netTotal        Decimal
  notes           String?
  createdBy       Uuid
  createdAt       TimestamptzString  @default(now())
  calculatedAt    TimestamptzString  @default(now())
  approvedBy      Uuid?
  approvedAt      TimestamptzString?
  paidAt          TimestamptzString?
  paymentReference String?
  cancelledBy     Uuid?
  cancelledAt     TimestamptzString?

  lines PayrollLine[]

  @@index([period], where: "\"status\" <> 'CANCELLED'", unique: true, name: "erp_payroll_runs_one_per_period")
  @@check(expression: "\"status\" IN ('DRAFT', 'APPROVED', 'PAID', 'CANCELLED')", name: "erp_payroll_runs_status")
  @@check(expression: "\"netTotal\" = \"grossTotal\" - \"deductionTotal\"", name: "erp_payroll_runs_total")
  @@map("erp_payroll_runs")
}

model PayrollLine {
  id               Uuid    @id @default(uuid())
  runId            Uuid
  employeeId       Uuid
  payBasis         String
  basicSalary      Decimal
  allowances       Decimal
  employedDays     Decimal
  paidDays         Decimal
  unpaidDays       Decimal
  unrecordedDays   Int
  overtimeHours    Decimal
  overtimeRate     Decimal
  basicEarned      Decimal
  allowancesEarned Decimal
  overtimePay      Decimal
  otherEarning     Decimal @default(0)
  grossPay         Decimal
  fixedDeduction   Decimal
  advanceRecovery  Decimal
  otherDeduction   Decimal @default(0)
  netPay           Decimal
  adjustmentNote   String?

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@check(expression: "\"grossPay\" = \"basicEarned\" + \"allowancesEarned\" + \"overtimePay\" + \"otherEarning\"", name: "erp_payroll_lines_gross")
  @@check(expression: "\"netPay\" = \"grossPay\" - \"fixedDeduction\" - \"advanceRecovery\" - \"otherDeduction\" AND \"netPay\" >= 0", name: "erp_payroll_lines_net")
  @@map("erp_payroll_lines")
}

// Phase 10: procurement and payables (see docs/ERP_DECISIONS.md D-029).

model Supplier {
  id                Uuid              @id @default(uuid())
  code              String            @unique
  name              String
  contactName       String?
  phone             String?
  email             String?
  address           String?
  taxRegistration   String?
  paymentTermsDays  Int               @default(30)
  status            String            @default("ACTIVE")
  notes             String?
  createdAt         TimestamptzString @default(now())
  updatedAt         TimestamptzString @default(now())

  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]

  @@index([name])
  @@check(expression: "\"status\" IN ('ACTIVE', 'INACTIVE')", name: "erp_suppliers_status")
  @@check(expression: "\"paymentTermsDays\" BETWEEN 0 AND 365", name: "erp_suppliers_terms")
  @@map("erp_suppliers")
}

model PurchaseRequisition {
  id                Uuid               @id @default(uuid())
  requisitionNumber String             @unique
  status            String             @default("DRAFT")
  neededBy          String?
  notes             String?
  idempotencyKey    String             @unique
  createdBy         Uuid
  createdAt         TimestamptzString  @default(now())
  submittedAt       TimestamptzString?
  decidedBy         Uuid?
  decidedAt         TimestamptzString?
  decisionNote      String?

  lines PurchaseRequisitionLine[]

  @@index([status])
  @@check(expression: "\"status\" IN ('DRAFT', 'SUBMITTED', 'APPROVED', 'REJECTED', 'CANCELLED', 'ORDERED')", name: "erp_purchase_requisitions_status")
  @@map("erp_purchase_requisitions")
}

model PurchaseRequisitionLine {
  id             Uuid    @id @default(uuid())
  requisitionId  Uuid
  lineNo         Int
  productId      Uuid
  quantity       Decimal
  plannedOrderId Uuid?   @unique
  notes          String?

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)

  @@unique([requisitionId, lineNo])
  @@check(expression: "\"quantity\" > 0", name: "erp_purchase_requisition_lines_quantity")
  @@map("erp_purchase_requisition_lines")
}

model Rfq {
  id             Uuid               @id @default(uuid())
  rfqNumber      String             @unique
  requisitionId  Uuid?
  status         String             @default("OPEN")
  responseDue    String?
  notes          String?
  awardedQuoteId Uuid?
  idempotencyKey String             @unique
  createdBy      Uuid
  createdAt      TimestamptzString  @default(now())
  closedAt       TimestamptzString?

  lines  RfqLine[]
  quotes RfqQuote[]

  @@index([status])
  @@check(expression: "\"status\" IN ('OPEN', 'AWARDED', 'CANCELLED')", name: "erp_rfqs_status")
  @@map("erp_rfqs")
}

model RfqLine {
  id        Uuid    @id @default(uuid())
  rfqId     Uuid
  lineNo    Int
  productId Uuid
  quantity  Decimal

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)

  @@unique([rfqId, lineNo])
  @@check(expression: "\"quantity\" > 0", name: "erp_rfq_lines_quantity")
  @@map("erp_rfq_lines")
}

model RfqQuote {
  id            Uuid              @id @default(uuid())
  rfqId         Uuid
  supplierId    Uuid
  quoteRef      String?
  validUntil    String?
  leadTimeDays  Int?
  taxPercent    Int               @default(0)
  totalAmount   Decimal
  notes         String?
  createdBy     Uuid
  createdAt     TimestamptzString @default(now())

  rfq   Rfq                @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  lines RfqQuoteLine[]

  @@unique([rfqId, supplierId])
  @@check(expression: "\"taxPercent\" BETWEEN 0 AND 100 AND \"totalAmount\" >= 0", name: "erp_rfq_quotes_amounts")
  @@map("erp_rfq_quotes")
}

model RfqQuoteLine {
  id        Uuid    @id @default(uuid())
  quoteId   Uuid
  rfqLineId Uuid
  unitPrice Decimal

  quote RfqQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([quoteId, rfqLineId])
  @@check(expression: "\"unitPrice\" >= 0", name: "erp_rfq_quote_lines_price")
  @@map("erp_rfq_quote_lines")
}

model PurchaseOrder {
  id             Uuid               @id @default(uuid())
  poNumber       String             @unique
  supplierId     Uuid
  status         String             @default("DRAFT")
  orderDate      String
  expectedDate   String?
  requisitionId  Uuid?
  rfqId          Uuid?
  subtotal       Decimal
  discountTotal  Decimal
  taxTotal       Decimal
  totalAmount    Decimal
  notes          String?
  idempotencyKey String             @unique
  createdBy      Uuid
  createdAt      TimestamptzString  @default(now())
  approvedBy     Uuid?
  approvedAt     TimestamptzString?
  closedAt       TimestamptzString?
  closeReason    String?

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]

  @@index([supplierId, status])
  @@index([status])
  @@check(expression: "\"status\" IN ('DRAFT', 'APPROVED', 'PARTIALLY_RECEIVED', 'RECEIVED', 'CLOSED', 'CANCELLED')", name: "erp_purchase_orders_status")
  @@check(expression: "\"totalAmount\" = \"subtotal\" - \"discountTotal\" + \"taxTotal\"", name: "erp_purchase_orders_total")
  @@map("erp_purchase_orders")
}

model PurchaseOrderLine {
  id                    Uuid    @id @default(uuid())
  purchaseOrderId       Uuid
  lineNo                Int
  productId             Uuid
  requisitionLineId     Uuid?
  quantity              Decimal
  unitPrice             Decimal
  discountPercent       Int     @default(0)
  taxPercent            Int     @default(0)
  grossAmount           Decimal
  discountAmount        Decimal
  taxAmount             Decimal
  lineTotal             Decimal
  receivedQuantity      Decimal @default(0)
  billedQuantity        Decimal @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, lineNo])
  @@index([productId])
  @@check(expression: "\"quantity\" > 0 AND \"unitPrice\" >= 0", name: "erp_purchase_order_lines_quantity")
  @@check(expression: "\"receivedQuantity\" >= 0 AND \"receivedQuantity\" <= \"quantity\"", name: "erp_purchase_order_lines_received")
  @@check(expression: "\"billedQuantity\" >= 0 AND \"billedQuantity\" <= \"receivedQuantity\"", name: "erp_purchase_order_lines_billed")
  @@check(expression: "\"discountPercent\" BETWEEN 0 AND 100 AND \"taxPercent\" BETWEEN 0 AND 100", name: "erp_purchase_order_lines_percents")
  @@check(expression: "\"lineTotal\" = \"grossAmount\" - \"discountAmount\" + \"taxAmount\"", name: "erp_purchase_order_lines_total")
  @@map("erp_purchase_order_lines")
}

model PurchaseReceipt {
  id              Uuid              @id @default(uuid())
  receiptNumber   String            @unique
  purchaseOrderId Uuid
  locationId      Uuid
  receivedDate    String
  deliveryNoteRef String?
  qualityHold     Boolean           @default(false)
  notes           String?
  idempotencyKey  String            @unique
  createdBy       Uuid
  createdAt       TimestamptzString @default(now())

  lines PurchaseReceiptLine[]

  @@index([purchaseOrderId])
  @@map("erp_purchase_receipts")
}

model PurchaseReceiptLine {
  id                  Uuid    @id @default(uuid())
  receiptId           Uuid
  purchaseOrderLineId Uuid
  quantity            Decimal

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@unique([receiptId, purchaseOrderLineId])
  @@check(expression: "\"quantity\" > 0", name: "erp_purchase_receipt_lines_quantity")
  @@map("erp_purchase_receipt_lines")
}

model SupplierBill {
  id                    Uuid               @id @default(uuid())
  billNumber            String             @unique
  supplierId            Uuid
  purchaseOrderId       Uuid?
  supplierInvoiceNumber String
  billDate              String
  dueDate               String
  status                String             @default("DRAFT")
  subtotal              Decimal
  discountTotal         Decimal
  taxTotal              Decimal
  totalAmount           Decimal
  notes                 String?
  idempotencyKey        String             @unique
  createdBy             Uuid
  createdAt             TimestamptzString  @default(now())
  approvedBy            Uuid?
  approvedAt            TimestamptzString?
  cancelledBy           Uuid?
  cancelledAt           TimestamptzString?
  cancelReason          String?

  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    SupplierBillLine[]
  payments SupplierPayment[]

  @@index([supplierId, status])
  @@index([dueDate])
  @@index([supplierId, supplierInvoiceNumber], where: "\"status\" <> 'CANCELLED'", unique: true, name: "erp_supplier_bills_unique_invoice")
  @@check(expression: "\"status\" IN ('DRAFT', 'APPROVED', 'CANCELLED')", name: "erp_supplier_bills_status")
  @@check(expression: "\"totalAmount\" = \"subtotal\" - \"discountTotal\" + \"taxTotal\"", name: "erp_supplier_bills_total")
  @@map("erp_supplier_bills")
}

model SupplierBillLine {
  id                  Uuid    @id @default(uuid())
  billId              Uuid
  lineNo              Int
  purchaseOrderLineId Uuid?
  productId           Uuid?
  description         String
  quantity            Decimal
  unitPrice           Decimal
  discountPercent     Int     @default(0)
  taxPercent          Int     @default(0)
  grossAmount         Decimal
  discountAmount      Decimal
  taxAmount           Decimal
  lineTotal           Decimal

  bill SupplierBill @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([billId, lineNo])
  @@check(expression: "\"quantity\" > 0 AND \"unitPrice\" >= 0", name: "erp_supplier_bill_lines_quantity")
  @@check(expression: "\"lineTotal\" = \"grossAmount\" - \"discountAmount\" + \"taxAmount\"", name: "erp_supplier_bill_lines_total")
  @@map("erp_supplier_bill_lines")
}

model SupplierPayment {
  id             Uuid               @id @default(uuid())
  paymentNumber  String             @unique
  billId         Uuid
  supplierId     Uuid
  paymentDate    String
  method         String
  reference      String?
  amount         Decimal
  status         String             @default("POSTED")
  notes          String?
  idempotencyKey String             @unique
  createdBy      Uuid
  createdAt      TimestamptzString  @default(now())
  voidedBy       Uuid?
  voidedAt       TimestamptzString?
  voidReason     String?

  bill SupplierBill @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@index([billId, status])
  @@check(expression: "\"amount\" > 0", name: "erp_supplier_payments_amount")
  @@check(expression: "\"status\" IN ('POSTED', 'VOIDED')", name: "erp_supplier_payments_status")
  @@check(expression: "\"method\" IN ('CASH', 'BANK_TRANSFER', 'CHEQUE', 'CARD', 'OTHER')", name: "erp_supplier_payments_method")
  @@map("erp_supplier_payments")
}
