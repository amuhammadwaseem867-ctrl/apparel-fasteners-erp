// use prisma-8
// ---------------------------------------------------------------------------
// Apparel Fasteners ERP — data contract (auth, sales, products, inventory)
//
// Conventions:
// - camelCase model/field names; snake_case physical table names via @@map.
// - Timestamps are TimestamptzString (text-backed) because the Node 24 runtime
//   lacks a global Temporal; never hand these to a Temporal codec.
// - No implicit many-to-many: Role-Permission and User-Role use explicit join
//   models (RolePermission, UserRole) as required by the SQL interpreter.
// ---------------------------------------------------------------------------

enum UserStatus {
  @@type("pg/text@1")
  ACTIVE = "ACTIVE"
  DISABLED = "DISABLED"
}

enum RoleStatus {
  @@type("pg/text@1")
  ACTIVE = "ACTIVE"
  DISABLED = "DISABLED"
}

model User {
  id           Uuid              @id @default(uuid())
  employeeCode String            @unique
  name         String
  email        String            @unique
  phone        String?
  passwordHash String
  status       UserStatus        @default(ACTIVE)
  lastLoginAt  TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())

  userRoles UserRole[]

  @@map("erp_users")
}

model Role {
  id          Uuid              @id @default(uuid())
  name        String            @unique
  code        String            @unique
  description String
  status      RoleStatus        @default(ACTIVE)
  isSystem    Boolean          @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("erp_roles")
}

model Permission {
  id          Uuid              @id @default(uuid())
  code        String            @unique
  name        String
  module      String
  action      String
  description String
  createdAt   TimestamptzString @default(now())

  rolePermissions RolePermission[]

  @@map("erp_permissions")
}

model RolePermission {
  id           Uuid              @id @default(uuid())
  roleId       Uuid
  permissionId Uuid
  grantedAt    TimestamptzString @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("erp_role_permissions")
}

model UserRole {
  id        Uuid              @id @default(uuid())
  userId    Uuid
  roleId    Uuid
  grantedAt TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("erp_user_roles")
}

model UserSession {
  id         Uuid               @id @default(uuid())
  userId     Uuid
  tokenHash  String             @unique
  expiresAt  TimestamptzString
  createdAt  TimestamptzString  @default(now())
  lastUsedAt TimestamptzString  @default(now())
  revokedAt  TimestamptzString?
  revokedBy  Uuid?
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("erp_user_sessions")
}

model AuditLog {
  id         Uuid              @id @default(uuid())
  actorId    Uuid?
  action     String
  entityType String?
  entityId   String?
  requestId  String?
  ip         String?
  metadata   String?
  createdAt  TimestamptzString @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("erp_audit_logs")
}

model Customer {
  id        Uuid              @id @default(uuid())
  code      String            @unique
  name      String
  email     String?
  phone     String?
  status    String            @default("ACTIVE")
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  salesOrders SalesOrder[]

  @@index([name])
  @@map("erp_customers")
}

model Product {
  id          Uuid              @id @default(uuid())
  sku         String            @unique
  name        String
  description String?
  category    String
  productType String
  variant     String?
  unit        String
  unitPrice   Decimal           @default(0)
  status      String            @default("ACTIVE")
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  // Item master specification (Phase 3). Every distinct size / material /
  // type / finish / colour / logo combination is its own product and SKU.
  size         String?
  material     String?
  itemType     String?
  finish       String?
  color        String?
  logoType     String?
  barcode      String?           @unique
  minimumStock Decimal           @default(0)

  salesOrderLines   SalesOrderLine[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@check(expression: "\"minimumStock\" >= 0", name: "erp_products_minimum_stock_nonnegative")
  @@map("erp_products")
}

model SalesOrder {
  id             Uuid              @id @default(uuid())
  orderNumber    String            @unique
  customerId     Uuid
  orderDate      String
  deliveryDate   String?
  status         String            @default("DRAFT")
  notes          String?
  subtotal       Decimal           @default(0)
  discountTotal  Decimal           @default(0)
  taxTotal       Decimal           @default(0)
  totalAmount    Decimal           @default(0)
  createdBy      Uuid
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    SalesOrderLine[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("erp_sales_orders")
}

model SalesOrderLine {
  id                Uuid    @id @default(uuid())
  salesOrderId      Uuid
  productId         Uuid?
  isCustom          Boolean @default(false)
  productName       String
  customerReference String?
  skuReference      String?
  category          String?
  variant           String?
  unit              String
  quantity          Decimal
  unitPrice         Decimal
  discountPercent   Int     @default(0)
  taxPercent        Int     @default(0)
  lineTotal         Decimal
  notes             String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
  @@index([productId])
  @@map("erp_sales_order_lines")
}

// ---------------------------------------------------------------------------
// Inventory (Phase 3)
//
// - StockBalance is the current position per product and storage location.
//   It changes only inside a stock-document transaction, by atomic
//   conditional UPDATEs, and CHECK constraints keep every bucket >= 0 and
//   reserved + quality hold <= on hand.
// - StockDocument + StockMovement are the append-only ledger. Every change
//   to a balance writes one movement row carrying the signed delta and the
//   resulting balance. Documents carry a unique idempotency key so a
//   repeated submission returns the original document instead of posting
//   twice.
// - Master data referenced by history is never cascade-deleted (Restrict);
//   it is archived through its status instead.
// ---------------------------------------------------------------------------

model Warehouse {
  id            Uuid              @id @default(uuid())
  code          String            @unique
  name          String
  warehouseType String            @default("GENERAL")
  address       String?
  status        String            @default("ACTIVE")
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())

  locations StorageLocation[]

  @@index([status])
  @@map("erp_warehouses")
}

model StorageLocation {
  id          Uuid              @id @default(uuid())
  warehouseId Uuid
  code        String
  name        String
  status      String            @default("ACTIVE")
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  balances     StockBalance[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([warehouseId, code])
  @@map("erp_storage_locations")
}

model StockBalance {
  id          Uuid              @id @default(uuid())
  productId   Uuid
  locationId  Uuid
  onHand      Decimal           @default(0)
  reserved    Decimal           @default(0)
  qualityHold Decimal           @default(0)
  updatedAt   TimestamptzString @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId])
  @@check(expression: "\"onHand\" >= 0 AND \"reserved\" >= 0 AND \"qualityHold\" >= 0", name: "erp_stock_balances_nonnegative")
  @@check(expression: "\"reserved\" + \"qualityHold\" <= \"onHand\"", name: "erp_stock_balances_committed_within_on_hand")
  @@map("erp_stock_balances")
}

model StockDocument {
  id             Uuid              @id @default(uuid())
  documentNumber String            @unique
  documentType   String
  status         String            @default("POSTED")
  reference      String?
  reason         String?
  notes          String?
  sourceType     String?
  sourceId       String?
  idempotencyKey String            @unique
  createdBy      Uuid
  postedAt       TimestamptzString @default(now())

  movements StockMovement[]

  @@index([documentType])
  @@index([postedAt])
  @@index([sourceType, sourceId])
  @@map("erp_stock_documents")
}

model StockMovement {
  id            Uuid              @id @default(uuid())
  documentId    Uuid
  lineNo        Int
  movementType  String
  productId     Uuid
  locationId    Uuid
  bucket        String
  quantityDelta Decimal
  balanceAfter  Decimal
  reservationId Uuid?
  createdBy     Uuid
  createdAt     TimestamptzString @default(now())

  document StockDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([documentId, lineNo, bucket])
  @@index([productId, createdAt])
  @@index([locationId])
  @@index([movementType])
  @@check(expression: "\"quantityDelta\" <> 0", name: "erp_stock_movements_nonzero")
  @@check(expression: "\"bucket\" IN ('ON_HAND', 'RESERVED', 'QUALITY_HOLD')", name: "erp_stock_movements_bucket")
  @@map("erp_stock_movements")
}

model StockReservation {
  id               Uuid              @id @default(uuid())
  productId        Uuid
  locationId       Uuid
  salesOrderId     Uuid?
  salesOrderLineId Uuid?
  quantity         Decimal
  consumedQuantity Decimal           @default(0)
  releasedQuantity Decimal           @default(0)
  status           String            @default("ACTIVE")
  notes            String?
  createdBy        Uuid
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([salesOrderId])
  @@index([status])
  @@check(expression: "\"quantity\" > 0 AND \"consumedQuantity\" >= 0 AND \"releasedQuantity\" >= 0 AND \"consumedQuantity\" + \"releasedQuantity\" <= \"quantity\"", name: "erp_stock_reservations_quantities")
  @@map("erp_stock_reservations")
}

model DocumentSequence {
  key       String            @id
  nextValue Int               @default(1)
  updatedAt TimestamptzString @default(now())

  @@check(expression: "\"nextValue\" >= 1", name: "erp_document_sequences_positive")
  @@map("erp_document_sequences")
}
